#!/bin/sh
# Fake pi for JSON-mode integration tests.
# Usage: fake-pi --mode json <prompt>
prompt="$3"

case "$prompt" in
  *fail*)
    printf '%s\n' '{"type":"session","version":3,"id":"fake"}'
    printf '%s\n' '{"type":"agent_start"}'
    printf '%s\n' '{"type":"turn_start"}'
    printf '%s\n' '{"type":"message_start","message":{"role":"user","content":"fail"}}'
    printf '%s\n' '{"type":"message_end","message":{"role":"user","content":"fail"}}'
    printf '%s\n' '{"type":"message_start","message":{"role":"assistant","content":[]}}'
    printf '%s\n' '{"type":"message_end","message":{"role":"assistant","content":[{"type":"text","text":"oops"}],"stopReason":"error"}}'
    printf '%s\n' '{"type":"turn_end"}'
    printf '%s\n' '{"type":"agent_end","willRetry":false}'
    printf '%s\n' '{"type":"agent_settled","aborted":false}'
    ;;
  *hang*)
    sleep 30
    ;;
  *)
    printf '%s\n' '{"type":"session","version":3,"id":"fake"}'
    printf '%s\n' '{"type":"agent_start"}'
    printf '%s\n' '{"type":"turn_start"}'
    printf '%s\n' '{"type":"message_start","message":{"role":"user","content":"hi"}}'
    printf '%s\n' '{"type":"message_end","message":{"role":"user","content":"hi"}}'
    printf '%s\n' '{"type":"message_start","message":{"role":"assistant","content":[]}}'
    printf '%s\n' '{"type":"message_update","assistantMessageEvent":{"type":"text_delta","contentIndex":0,"delta":"Hello "}}'
    printf '%s\n' '{"type":"message_update","assistantMessageEvent":{"type":"text_delta","contentIndex":0,"delta":"world"}}'
    printf '%s\n' '{"type":"message_end","message":{"role":"assistant","content":[{"type":"text","text":"Hello world!"}],"stopReason":"end"}}'
    printf '%s\n' '{"type":"turn_end"}'
    printf '%s\n' '{"type":"agent_end","willRetry":false}'
    printf '%s\n' '{"type":"agent_settled","aborted":false}'
    ;;
esac
